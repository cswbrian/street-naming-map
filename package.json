{
  "name": "scaffold",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run og:image && vite build",
    "og:image": "node scripts/render-og-image.mjs",
    "lint": "eslint . && npm run lint:gazettes",
    "lint:gazettes": "node scripts/lint-gazettes.mjs",
    "backfill:notice-stems": "node scripts/backfill-notice-stems.mjs",
    "preview": "vite preview",
    "prepare:data": "node scripts/prepare-mock-road-years.mjs",
    "report:pending-years": "node scripts/report-pending-naming-years.mjs",
    "migrate:street-code-to-map": "node scripts/migrate-street-code-to-map.mjs",
    "strip:event-street-codes": "node scripts/strip-event-street-codes.mjs",
    "report:unmapped-events": "node scripts/report-unmapped-events.mjs",
    "report:street-timelines": "node scripts/report-street-timelines.mjs",
    "apply:street-links": "node scripts/apply-street-links.mjs",
    "fetch:egazette": "node scripts/fetch-egazette-street-pdfs.mjs --download-only",
    "fetch:egazette:download": "node scripts/fetch-egazette-street-pdfs.mjs --download-only",
    "fetch:egazette:bootstrap": "node scripts/fetch-egazette-street-pdfs.mjs --bootstrap-only --browser-channel chrome",
    "fetch:egazette:bootstrap:chrome": "playwright codegen --channel=chrome --save-storage=data/egazette/session/storageState.json \"https://egazette.gld.gov.hk/zh/terms-acceptance?intended=https%3A%2F%2Fegazette.gld.gov.hk%2Fzh%2Fsearch-gazette%2Fgazette\"",
    "fetch:egazette:harvest": "node scripts/fetch-egazette-street-pdfs.mjs --harvest-only --no-resume",
    "fetch:egazette:harvest:all": "node scripts/fetch-egazette-street-pdfs.mjs --harvest-only --all-periods --no-resume",
    "fetch:egazette:dry-run": "node scripts/fetch-egazette-street-pdfs.mjs --dry-run",
    "fetch:egazette:test": "node scripts/fetch-egazette-street-pdfs.mjs --self-test",
    "parse:egazette:pilot": "node scripts/parse-egazette-pdfs.mjs --pilot",
    "parse:egazette:pilot:regex": "node scripts/parse-egazette-pdfs.mjs --pilot --use-regex --no-resume",
    "parse:egazette": "node scripts/parse-egazette-pdfs.mjs",
    "parse:egazette:extract": "node scripts/parse-egazette-pdfs.mjs --extract-only",
    "parse:egazette:extract:all": "node scripts/parse-egazette-pdfs.mjs --extract-only --no-resume",
    "parse:egazette:regex": "node scripts/parse-egazette-pdfs.mjs --use-regex --no-resume",
    "parse:egazette:llm-remaining": "node scripts/parse-egazette-pdfs.mjs --llm-remaining",
    "parse:egazette:llm-remaining:merge": "node scripts/parse-egazette-pdfs.mjs --llm-remaining && node scripts/merge-egazette-naming.mjs",
    "parse:egazette:map": "node scripts/parse-egazette-pdfs.mjs --use-regex --no-resume && node scripts/merge-egazette-naming.mjs",
    "validate:egazette:pilot": "node scripts/validate-egazette-pilot.mjs",
    "merge:egazette": "node scripts/merge-egazette-naming.mjs",
    "merge:egazette:pilot": "node scripts/merge-egazette-naming.mjs --pilot",
    "publish:egazette-pdfs": "node scripts/publish-egazette-pdfs.mjs",
    "prepare:egazette-links": "node scripts/publish-egazette-pdfs.mjs && node scripts/report-pending-naming-years.mjs",
    "rebuild:naming": "node scripts/rebuild-street-naming.mjs",
    "import:crowdsubmissions": "node scripts/import-crowd-submissions.mjs",
    "migrate:evidence-kind": "node scripts/migrate-evidence-kind.mjs",
    "classify:unknown-egazette": "node scripts/classify-unknown-egazette.mjs",
    "classify:news-evidence": "node scripts/classify-news-evidence.mjs",
    "migrate:street-schema": "node scripts/migrate-evidence-kind.mjs && npm run rebuild:naming && npm run report:pending-years",
    "apply:crowd": "npm run import:crowdsubmissions && npm run rebuild:naming && npm run report:pending-years",
    "apply:crowd:batch": "node scripts/apply-crowd-batch.mjs",
    "parse:crowd-gazette-pdf": "node scripts/parse-crowd-gazette-pdf.mjs",
    "publish:crowd-gazettes": "node scripts/publish-crowd-gazette-pdfs.mjs --update-data && npm run rebuild:naming && npm run report:pending-years",
    "migrate:hosted-gazette-urls": "node scripts/migrate-hosted-gazette-urls.mjs && npm run report:pending-years"
  },
  "dependencies": {
    "@deck.gl/layers": "^9.3.1",
    "@deck.gl/mapbox": "^9.3.1",
    "deck.gl": "^9.3.1",
    "maplibre-gl": "^5.24.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-router-dom": "^7.15.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.5.0",
    "pdfjs-dist": "^5.7.284",
    "playwright": "^1.60.0",
    "vite": "^8.0.10"
  }
}
